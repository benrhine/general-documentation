        <mxCell id="oWYSpkivO3OfPZszFI1K-160" value="Jobs have the following naming convention ...&lt;br&gt;&lt;br&gt;APP-SHORT-NAME | DEPLOY TYPE | ACTION | BRANCH | ENVIRONMENT&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="365" y="1120" width="425" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-185" value="IF ANY NP deploy job fails it will execute a remove in &quot;post_build&quot; block to ensure the environment is ready for a future deploy. The should prevent seeing the error &quot; ... is in ROLLBACK state&quot; when attempting to deploy to a non-clean instance. &lt;b&gt;TO BE CLEAR, IN THE EVENT OF A FAILURE THIS WILL UNDEPLOY A GIVEN ENVIRONMENT.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="365" y="1200" width="425" height="80" as="geometry" />
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-186" value="If the PROD deploy fails &lt;b&gt;IT WILL NOT ATTEMPT&lt;/b&gt; to clean up the environment as if a previous deploy is still working we do not want to remove it. In the event PROD deploy fails the job will abort and &quot;...prod-release&quot; tag &lt;b&gt;WILL NOT&lt;/b&gt;&amp;nbsp;be applied to the branch" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="390" y="1280" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-187" value="These roles are necessary for build jobs and deployments to execute" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="420" y="30" width="370" height="80" as="geometry" />
        </mxCell>
