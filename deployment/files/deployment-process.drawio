        <mxCell id="oWYSpkivO3OfPZszFI1K-148" value="Generates tagged release candidate for test ENV and deploys&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;to guarantee dev and test are the same" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="oWYSpkivO3OfPZszFI1K-147">
