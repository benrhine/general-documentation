        <mxCell id="oWYSpkivO3OfPZszFI1K-40" value="Generates application specific role, and any additional&lt;br&gt;required resources.&amp;nbsp;This allows each app to have unique&lt;br&gt;but codified IAM roles and resources." style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="oWYSpkivO3OfPZszFI1K-38">
          <mxGeometry x="-0.1241" y="-2" relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-188" value="Text" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="oWYSpkivO3OfPZszFI1K-38">
          <mxGeometry x="-0.0275" y="11" relative="1" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-82" value="&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;NP jobs conditionally create resources for ALL non prod environments in one (ie single) deployment job. This allows some generic resources like IAM roles to be shared. However, this does have the downside of IF you want to remove a resource and it is used by a different NP environment the remove will fail as the resource is in use. These jobs are idempotent (meaning they can be run repeatedly) and they will only update the necessary resources. This should prevent the need to ever remove a resource.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;P jobs are separated to ensure they are not accidentally modifying prod resources.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Note: All NP jobs will attempt to clean up and &lt;b&gt;WILL REMOVE RESOURCES&lt;/b&gt; in the event the deploy fails" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="40" y="530" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="oWYSpkivO3OfPZszFI1K-77" value="Release Jobs" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="oWYSpkivO3OfPZszFI1K-3">
          <mxGeometry x="25" y="780" width="340" height="120" as="geometry" />
